{
  "name": "xjdz-live",
  "main": "cf-worker.js",
  "compatibility_date": "2026-11-01",
  "routes": [{ "pattern": "xjdz.de5.net", "custom_domain": true }],
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "RoomHub" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomHub"] }],
  "assets": {
    "directory": "./dist-site",
    "binding": "ASSETS"
  },
  "vars": {
    "TURN_KEY_ID": "1e00352be0bc5fa6e1745a8c1554853a",
    "ALLOWED_ORIGIN": "https://xjdz.de5.net"
  }
}
